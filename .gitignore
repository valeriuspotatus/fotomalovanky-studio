# Secrets & live config — contains the token-scoped generator URL. NEVER commit.
config.json
.env
.env.*

# Runtime data: customer photos, generated outputs, per-order state.json, PDFs
/inbox/
/outbox/
**/state.json

# Playwright debug artifacts — may embed the token URL and customer photos. Keep local.
/.traces/
trace.zip
test-results/
playwright-report/

# Reverse-engineering captures & generator bundles — HARs contain the token-scoped
# URL; coloring-book-*.zip and order folders contain customer photos + PII. Local only.
*.har
HAR.txt
*.zip
coloring-book-*.zip
# Real/sample order folders dropped into the repo during dev (customer photos + names)
Fotomalovanky.cz*/
Objedn*/

# Loose customer photos / renders dropped at the repo root while comparing outputs.
# No image belongs at the top level, so ignore them all rather than rely on remembering.
/*.png
/*.jpg
/*.jpeg
/*.svg
# Operator's fixture pack. The SOP inside embeds the live token-scoped generator URL and
# the screen recording shows it on camera; plus ~211MB of images. Local only.
Fotomalovanky Automation/

# A copy of the Shopify Chrome extension, kept here only to read. It belongs to someone else
# and is not part of this tool. The one Brave loads lives on the Desktop.
Shopify chrome extention/

# Reference material from the ad designer + design explorations — inspiration only, not app code
# (may embed licensed stock imagery). The bundled brand asset in src/ui/static/creatives/ is tracked.
Our ads/
New design/
Marketing Automatization/

# Operator scratch notes and throwaway dev drivers dropped at the repo root (order pulls, run probes).
workflow.txt
/_*
# David's feature specs and the marketing calendar PDF dropped in for reference — not app code.
Revamped generator.txt
Our callendar/

# David's full Fotomalovánky reference archive + Figma ad exports (dropped 2026-07-14 to ground the
# creatives rework). Inspiration only, never app code. Fotomalovanky/ holds customer order PDFs/photos
# and a CV (PII) + licensed stock; both are bulky. Local-only — never commit.
Fotomalovanky/
Figma/

# Overnight autopilot: the read_orders token, the poll cursor / handled-set, and the night report all
# carry a full-store credential or customer PII. They default OUTSIDE the repo (config.shopify.dataDir),
# but never commit them whatever folder they land in — nor a Shopify order CSV export (also PII).
shopify-token*.json
autopilot-state.json
overnight-report.json
/autopilot/
*_export*.csv
*_orders_export*.csv
# Machine-specific hidden-launch wrapper generated by installAutopilotTask.ps1 (absolute node path).
tools/run-autopilot-hidden.vbs

# Declutter buckets: throwaway dev drivers/logs (scratch/) and David's spec/asset
# reference material (reference/). Everything inside is local-only, not app code.
scratch/
reference/

# David's business docs dropped into docs/ for reference — pricing, ad copy, GTM, marketing
# strategy. Not app code, and the GTM sheet holds plaintext social-media passwords. Local only.
docs/*.docx
docs/*.xlsx

# The migration extraction's secrets companion — the live Gemini key, Shopify token, Bridge
# password and generator URL token, in plaintext, so PROJECT_EXTRACTION.md itself can stay
# committable. This file must never enter git: pushing main also auto-deploys to Render.
PROJECT_EXTRACTION.secrets.md

# Node
node_modules/
npm-debug.log*

# Free printable sets built by tools/printables.js — generated art + the assembled PDF.
# Reproducible from the committed theme definition, and heavy. Local only.
/printables/

# Shopify OAuth client credentials (client id + secret) used to mint an app token.
# Plaintext secret. Local only, never commit.
shopify.txt

# Throwaway Shopify OAuth authorize URL (carries client_id + CSRF state). Local only.
authorize-url.txt
